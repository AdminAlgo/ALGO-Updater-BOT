# ELD Alert Bot — secrets
# Copy this file to ".env" and fill in real values. NEVER commit .env.

# Factor ELD = DriveHOS Partner API.
FACTOR_API_BASE_URL=https://api.drivehos.app
# Provider key — platform-wide, shared across every Factor company. Sent as
# the X-API-Provider-Key header. Issued once by Factor/DriveHOS.
FACTOR_API_KEY=

# Leader ELD = same DriveHOS backend as Factor (confirmed by Leader/DriveHOS
# support: Leader is a white-label of the same backend), same base URL — but
# its own separate Provider key.
LEADER_API_BASE_URL=https://api.drivehos.app
LEADER_API_KEY=

# Telegram bot
TELEGRAM_BOT_TOKEN=123456789:your-telegram-bot-token-here

# Per-company API keys (X-API-Company-Key). One env var per company; the
# variable NAME is referenced from config.yaml via each company's
# "company_key_env" field. Add one per company — get it from that platform's
# admin/"System Manager" account (Keys page), not from Factor/DriveHOS
# support directly.
WWH_COMPANY_KEY=
GOWIN_COMPANY_KEY=

# Admin dashboard (python main.py --serve). Single shared admin login.
# Generate DASHBOARD_SECRET_KEY with: python -c "import secrets; print(secrets.token_hex(32))"
DASHBOARD_ADMIN_PASSWORD=
DASHBOARD_SECRET_KEY=

# Optional: comma-separated Telegram numeric user IDs allowed to use /admin,
# /drivers, /add, and /remove. Leave empty during initial setup.
ADMIN_TELEGRAM_USER_IDS=
