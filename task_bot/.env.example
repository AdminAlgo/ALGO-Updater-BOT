# ALGO Task Bot settings. Put real values in Railway -> Variables (never in git).

# From @BotFather. Required.
TELEGRAM_BOT_TOKEN=

# Username and password of the one main website account. Password is required.
# (They can later be changed on the website -> Account.)
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=
# Any long random text. Required. Keeps website logins safe.
SECRET_KEY=

# Telegram usernames of admins, comma separated, without @.
ADMIN_USERNAMES=milord0_0,Abdulakhatov04

# Official accounts that may also create tasks in private chat (cannot approve), comma separated.
TASK_CREATOR_USERNAMES=

# Optional. Normally set with /setgroup inside the team group.
GROUP_CHAT_ID=

# Where the database lives. On Railway this is the volume mount path.
DATA_DIR=/data

# Defaults, change only if needed.
TIMEZONE=Asia/Tashkent
CHECKIN_TIMES=17:00,01:00
REMIND_AFTER_MIN=30
ESCALATE_AFTER_MIN=60
OVERDUE_EVERY_HOURS=3
